# ─── Vercel Environment Variables ────────────────────────────
# Bu qiymatlar Vercel loyihasining Settings → Environment Variables
# bo'limiga qo'shiladi (Production, Preview va Development uchun).
# Bu fayl namuna — haqiqiy qiymatlar hech qachon git'ga tushmaydi.

# Telegram bot tokeni. initData imzosi shu bilan tekshiriladi —
# ya'ni bu token butun autentifikatsiyaning kalitidir. Sizib chiqsa,
# istalgan odam istalgan foydalanuvchi nomidan kira oladi.
BOT_TOKEN=

# Firebase service account JSON — BUTUNLIGICHA, bitta qatorda.
# Firebase Console → Project Settings → Service accounts →
# "Generate new private key" tugmasi bilan olinadi.
# Faylni ochib, ichidagi JSON'ni to'liq nusxalang.
FIREBASE_SERVICE_ACCOUNT=

# Admin panelning to'liq manzili. Yangi buyurtma xabarnomasidagi
# «Admin paneldan ochish» tugmasi shu manzilga olib boradi.
# Oxirida / bo'lishi shart: .../admin/
ADMIN_PANEL_URL=https://musa-delivery.vercel.app/admin

# ─── Linko (SFA) integratsiyasi ──────────────────────────────
# Katalog, narx va ombor qoldig'i Linko'dan tortiladi.
# Token Linko texnik yordamidan olinadi va FAQAT shu yerda turadi:
# `settings/linko` hujjatini tizimga kirgan har bir mijoz o'qiy oladi,
# shuning uchun token bazaga yozilmaydi.
LINKO_TOKEN=

# Server manzili odatda admin paneldan kiritiladi (Linko integratsiya
# bo'limi). Bu yerdagi qiymat — hujjat hali yaratilmaganda zaxira.
LINKO_BASE_URL=https://sfademo.linko.uz

# Jadval bo'yicha sinxron uchun maxfiy kalit. Uzun tasodifiy satr
# bo'lsin — /api/linko-cron shu bilan himoyalanadi. Xuddi shu qiymat
# bot/.env ga ham qo'yiladi (bot kun davomida sinxronni chaqiradi).
CRON_SECRET=


# ─── Env'da BO'LMAYDIGAN qiymatlar ───────────────────────────
# Quyidagilar ataylab env'da emas — ular maxfiy emas va bitta
# fayldan o'qiladi:
#
#   Firebase web config (apiKey, projectId, ...) → src/config/firebase.ts
#   Bot username, telefon, email, Telegram        → src/config/brand.ts
#   Bot tokeni (maxfiy!)                          → bot/.env
#   Mini app domeni, adminlar, karta, bucket      → bot/config.py
#
# To'liq ro'yxat: DEPLOY.md → "0. MUSA ga o'tish".
